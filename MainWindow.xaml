<Window x:Class="SecureFile.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SecureFile" Height="720" Width="1020" MinHeight="640" MinWidth="880"
        Background="{DynamicResource ThemeBackground}" WindowStartupLocation="CenterScreen"
        Icon="icon.ico" PreviewKeyDown="Window_PreviewKeyDown"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
  <Window.Resources>
    <Style x:Key="MutedText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ThemeMuted}"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeMuted}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="10"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ThemeHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ThemePressed}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource ThemeAccent}"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeOnAccent}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="24,11"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="10"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.88"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.75"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource ThemePanel}"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="18,9"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ThemeHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ThemePressed}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ActionCard" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource ThemePanel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="24"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="16" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ThemeHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ThemePressed}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="MethodCard" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Chrome" Background="{DynamicResource ThemeSurface}"
                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                    CornerRadius="12" Padding="14,12">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ThemeAccentSoft}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="MethodPill" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource ThemeMuted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Chrome" Background="{DynamicResource ThemeSurface}"
                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                    CornerRadius="11" Padding="10,4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ThemeAccentSoft}"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SettingCheckBox" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1"
                      BorderBrush="{DynamicResource ThemeBorder}" Background="{DynamicResource ThemeBackground}"
                      VerticalAlignment="Center">
                <Path x:Name="Check" Data="M 3 8 L 7 12 L 14 4" Stroke="{DynamicResource ThemeOnAccent}"
                      StrokeThickness="2" Visibility="Collapsed" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource ThemeAccent}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PasswordInput" TargetType="PasswordBox">
      <Setter Property="Background" Value="{DynamicResource ThemeBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="CaretBrush" Value="{DynamicResource ThemeText}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                            HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                            VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ThemeCardItem" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Selection" CornerRadius="10" BorderThickness="2"
                    BorderBrush="Transparent" Padding="1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Selection" Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Selection" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="ThemeCardTemplate">
      <Border Width="100" Height="80" Background="{Binding PreviewBackground}"
              BorderBrush="{Binding PreviewBorder}" BorderThickness="1" CornerRadius="8" Padding="8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border Height="5" CornerRadius="2.5" Background="{Binding PreviewAccent}"/>
          <Border Grid.Row="1" Background="{Binding PreviewPanel}" CornerRadius="5" Margin="0,7,0,0" Padding="6,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Width="7" Height="7" Fill="{Binding PreviewAccent}"/>
              <Border Width="34" Height="4" CornerRadius="2" Background="{Binding PreviewMuted}" Margin="6,0,0,0"/>
            </StackPanel>
          </Border>
          <TextBlock Grid.Row="2" Text="{Binding Name}" Foreground="{Binding PreviewText}"
                     FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
        </Grid>
      </Border>
    </DataTemplate>
    <Style x:Key="SwatchButton" TargetType="Button">
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="3">
              <ContentPresenter/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FileListStyle" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <ScrollViewer Focusable="false" Padding="{TemplateBinding Padding}">
              <ItemsPresenter/>
            </ScrollViewer>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FileListItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="12,8">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource ThemeHover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid x:Name="RootGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="228"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{DynamicResource ThemePanel}"
              BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0">
        <Grid Margin="18,26,18,20">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel>
            <TextBlock Text="SecureFile" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource ThemeText}"/>
            <TextBlock Text="AES-256" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
          </StackPanel>

          <StackPanel Grid.Row="1" Margin="0,34,0,0">
            <Button x:Name="NavHome" Content="🏠 Home" Style="{StaticResource NavButton}" Click="ShowHome_Click"/>
            <Button x:Name="NavEncrypt" Content="🔒 Encrypt" Style="{StaticResource NavButton}" Margin="0,4,0,0"
                    Click="ShowEncrypt_Click"/>
            <Button x:Name="NavDecrypt" Content="🔓 Decrypt" Style="{StaticResource NavButton}" Margin="0,4,0,0"
                    Click="ShowDecrypt_Click"/>
          </StackPanel>

          <StackPanel Grid.Row="3">
            <Button x:Name="NavSettings" Content="⚙ Settings" Style="{StaticResource NavButton}"
                    Click="SettingsToggle_Click"/>
            <Button x:Name="NavProtection" Content="🛡 Protection" Style="{StaticResource NavButton}" Margin="0,4,0,0"
                    Click="ProtectionToggle_Click"/>
            <TextBlock Text="v2 · 2026" Style="{StaticResource MutedText}" FontSize="11" Margin="14,16,0,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="1" Margin="32,26,32,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <StackPanel x:Name="HomeView" VerticalAlignment="Center" MaxWidth="700">
            <TextBlock x:Name="HomeTitle" Text="Your files, sealed." FontSize="34" FontWeight="Bold"
                       Foreground="{DynamicResource ThemeText}" TextWrapping="Wrap"/>
            <TextBlock x:Name="HomeSubtitle" Style="{StaticResource MutedText}" FontSize="14"
                       Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"/>
            <Grid Margin="0,30,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="HomeEncryptCard" Grid.Column="0" Style="{StaticResource ActionCard}"
                      Click="ShowEncrypt_Click">
                <StackPanel>
                  <TextBlock Text="🔒" FontSize="26"/>
                  <TextBlock x:Name="HomeEncryptTitle" Text="Encrypt files" FontSize="18" FontWeight="SemiBold"
                             Foreground="{DynamicResource ThemeText}" Margin="0,12,0,0"/>
                  <TextBlock x:Name="HomeEncryptText" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                             Margin="0,6,0,14"/>
                  <TextBlock Text="→" FontSize="18" Foreground="{DynamicResource ThemeAccent}"/>
                </StackPanel>
              </Button>
              <Button x:Name="HomeDecryptCard" Grid.Column="2" Style="{StaticResource ActionCard}"
                      Click="ShowDecrypt_Click">
                <StackPanel>
                  <TextBlock Text="🔓" FontSize="26"/>
                  <TextBlock x:Name="HomeDecryptTitle" Text="Decrypt files" FontSize="18" FontWeight="SemiBold"
                             Foreground="{DynamicResource ThemeText}" Margin="0,12,0,0"/>
                  <TextBlock x:Name="HomeDecryptText" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                             Margin="0,6,0,14"/>
                  <TextBlock Text="→" FontSize="18" Foreground="{DynamicResource ThemeAccent}"/>
                </StackPanel>
              </Button>
            </Grid>
            <TextBlock x:Name="HomeDropHint" Style="{StaticResource MutedText}"
                       HorizontalAlignment="Center" Margin="0,26,0,0"/>
          </StackPanel>

          <Grid x:Name="EncryptView" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
              <StackPanel>
                <TextBlock x:Name="EncryptTitle" Text="Encrypt files" FontSize="26" FontWeight="Bold"
                           Foreground="{DynamicResource ThemeText}"/>
                <TextBlock x:Name="EncryptSubtitle" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
              </StackPanel>
              <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock x:Name="EncryptMethodBadge" FontSize="12" Foreground="{DynamicResource ThemeMuted}"
                           HorizontalAlignment="Right"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                  <RadioButton x:Name="EncryptFastPill" Style="{StaticResource MethodPill}"
                               GroupName="EncryptMethod" Tag="Fast" Content=".secf"
                               Checked="EncryptMethod_Checked"/>
                  <RadioButton x:Name="EncryptMediumPill" Style="{StaticResource MethodPill}"
                               GroupName="EncryptMethod" Tag="Medium" Content=".secf1"
                               Checked="EncryptMethod_Checked"/>
                  <RadioButton x:Name="EncryptMaxPill" Style="{StaticResource MethodPill}"
                               GroupName="EncryptMethod" Tag="Maximum" Content=".secf1v2"
                               Margin="0" Checked="EncryptMethod_Checked"/>
                </StackPanel>
              </StackPanel>
            </Grid>
            <Border Grid.Row="1" Margin="0,20,0,0" Height="96" Background="{DynamicResource ThemeSurface}"
                    CornerRadius="12">
              <Grid>
                <Rectangle Stroke="{DynamicResource ThemeBorder}" StrokeDashArray="4 3" RadiusX="12" RadiusY="12"
                           Margin="1"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="⬇" FontSize="20" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,10,0"/>
                  <TextBlock x:Name="EncryptDropHint" Style="{StaticResource MutedText}"/>
                </StackPanel>
              </Grid>
            </Border>
            <Grid Grid.Row="2" Margin="0,14,0,0">
              <Border Background="{DynamicResource ThemePanel}" BorderBrush="{DynamicResource ThemeBorder}"
                      BorderThickness="1" CornerRadius="12">
                <ListBox x:Name="EncryptList" Style="{StaticResource FileListStyle}"
                         ItemContainerStyle="{StaticResource FileListItem}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ThemeText}" FontSize="13"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource MutedText}"
                                   FontSize="12"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>
              <TextBlock x:Name="EncryptEmptyText" Style="{StaticResource MutedText}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                         MaxWidth="320" TextAlignment="Center"/>
            </Grid>
            <Grid Grid.Row="3" Margin="0,16,0,0">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="EncryptAddButton" Content="Add files…" Style="{StaticResource SecondaryButton}"
                        Click="ChooseEncrypt_Click"/>
                <Button x:Name="EncryptAddFolderButton" Content="Add folder…" Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0" Click="ChooseEncryptFolder_Click"/>
                <Button x:Name="EncryptClearButton" Content="Clear list" Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0" Click="ClearEncrypt_Click"/>
              </StackPanel>
              <Button x:Name="EncryptActionButton" Content="Encrypt" Style="{StaticResource PrimaryButton}"
                      HorizontalAlignment="Right" Click="Encrypt_Click"/>
            </Grid>
          </Grid>

          <Grid x:Name="DecryptView" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
              <TextBlock x:Name="DecryptTitle" Text="Decrypt files" FontSize="26" FontWeight="Bold"
                         Foreground="{DynamicResource ThemeText}"/>
              <TextBlock x:Name="DecryptSubtitle" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
            </StackPanel>
            <Border Grid.Row="1" Margin="0,20,0,0" Height="96" Background="{DynamicResource ThemeSurface}"
                    CornerRadius="12">
              <Grid>
                <Rectangle Stroke="{DynamicResource ThemeBorder}" StrokeDashArray="4 3" RadiusX="12" RadiusY="12"
                           Margin="1"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="⬇" FontSize="20" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,10,0"/>
                  <TextBlock x:Name="DecryptDropHint" Style="{StaticResource MutedText}"/>
                </StackPanel>
              </Grid>
            </Border>
            <Grid Grid.Row="2" Margin="0,14,0,0">
              <Border Background="{DynamicResource ThemePanel}" BorderBrush="{DynamicResource ThemeBorder}"
                      BorderThickness="1" CornerRadius="12">
                <ListBox x:Name="DecryptList" Style="{StaticResource FileListStyle}"
                         ItemContainerStyle="{StaticResource FileListItem}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ThemeText}" FontSize="13"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource MutedText}"
                                   FontSize="12"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>
              <TextBlock x:Name="DecryptEmptyText" Style="{StaticResource MutedText}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                         MaxWidth="320" TextAlignment="Center"/>
            </Grid>
            <Grid Grid.Row="3" Margin="0,16,0,0">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="DecryptAddButton" Content="Add encrypted files…"
                        Style="{StaticResource SecondaryButton}" Click="ChooseDecrypt_Click"/>
                <Button x:Name="DecryptAddFolderButton" Content="Add folder…"
                        Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        Click="ChooseDecryptFolder_Click"/>
                <Button x:Name="DecryptClearButton" Content="Clear list"
                        Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        Click="ClearDecrypt_Click"/>
              </StackPanel>
              <Button x:Name="DecryptActionButton" Content="Decrypt" Style="{StaticResource PrimaryButton}"
                      HorizontalAlignment="Right" Click="Decrypt_Click"/>
            </Grid>
          </Grid>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,0">
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}"/>
            <TextBlock x:Name="NoticeText" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"
                       Visibility="Collapsed" MaxWidth="520" HorizontalAlignment="Left"/>
          </StackPanel>
          <Border x:Name="ProgressPanel" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Width="340" Visibility="Collapsed">
            <StackPanel>
              <Grid>
                <TextBlock x:Name="ProgressText" Style="{StaticResource MutedText}" HorizontalAlignment="Left"/>
                <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource SecondaryButton}"
                        Padding="14,6" FontSize="12" HorizontalAlignment="Right" Click="Cancel_Click"/>
              </Grid>
              <ProgressBar x:Name="OperationProgress" Height="8" Minimum="0" Maximum="100" Margin="0,8,0,0"
                           Foreground="{DynamicResource ThemeAccent}"
                           Background="{DynamicResource ThemeSurface}" BorderThickness="0"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>
    <Border x:Name="SettingsOverlay" Background="{DynamicResource ThemeOverlay}" Visibility="Collapsed">
      <Border Background="{DynamicResource ThemePanel}" BorderBrush="{DynamicResource ThemeBorder}"
              BorderThickness="1" CornerRadius="14" MaxWidth="840" MaxHeight="640" Margin="24"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel Margin="26,22,26,0">
            <TextBlock x:Name="SettingsTitle" Text="Settings" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource ThemeText}"/>
            <TextBlock x:Name="SettingsSubtitle" Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
          </StackPanel>

          <ScrollViewer Grid.Row="1" Margin="26,16,18,0" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,8">
              <TextBlock x:Name="SettingsAppearanceTitle" Text="Appearance" FontSize="16" FontWeight="SemiBold"
                         Foreground="{DynamicResource ThemeText}"/>
              <TextBlock x:Name="SettingsAppearanceText" Style="{StaticResource MutedText}" Margin="0,3,0,10"/>
              <Grid Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="LightModeButton" Content="☀ Light" Style="{StaticResource SecondaryButton}"
                          Click="LightMode_Click"/>
                  <Button x:Name="DarkModeButton" Content="🌙 Dark" Style="{StaticResource SecondaryButton}"
                          Margin="8,0,0,0" Click="DarkMode_Click"/>
                </StackPanel>
                <TextBlock x:Name="ThemeSummaryText" Style="{StaticResource MutedText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
              <ListBox x:Name="ThemeList" Height="250" Background="Transparent" BorderThickness="0"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       SelectionChanged="ThemeList_SelectionChanged"
                       ItemContainerStyle="{StaticResource ThemeCardItem}"
                       ItemTemplate="{StaticResource ThemeCardTemplate}">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel/>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
              </ListBox>
              <TextBlock x:Name="BackgroundLabel" Style="{StaticResource MutedText}" Margin="0,12,0,8"/>
              <WrapPanel x:Name="BackgroundSwatchPanel"/>

              <Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,10,0,18"/>

              <TextBlock x:Name="SettingsSecurityTitle" Text="Security" FontSize="16" FontWeight="SemiBold"
                         Foreground="{DynamicResource ThemeText}"/>
              <TextBlock x:Name="SettingsSecurityText" Style="{StaticResource MutedText}" Margin="0,3,0,12"/>
              <TextBlock x:Name="SettingsMethodLabel" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>

              <RadioButton x:Name="FastMethodRadio" Style="{StaticResource MethodCard}" GroupName="Method"
                           Tag="Fast" Checked="Method_Checked">
                <StackPanel>
                  <Grid>
                    <TextBlock x:Name="FastMethodName" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource ThemeText}"/>
                    <TextBlock Text=".secf" HorizontalAlignment="Right" Style="{StaticResource MutedText}"
                               FontSize="12"/>
                  </Grid>
                  <TextBlock x:Name="FastMethodDesc" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                             Margin="0,4,0,0"/>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="MediumMethodRadio" Style="{StaticResource MethodCard}" GroupName="Method"
                           Tag="Medium" Checked="Method_Checked">
                <StackPanel>
                  <Grid>
                    <TextBlock x:Name="MediumMethodName" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource ThemeText}"/>
                    <TextBlock Text=".secf1" HorizontalAlignment="Right" Style="{StaticResource MutedText}"
                               FontSize="12"/>
                  </Grid>
                  <TextBlock x:Name="MediumMethodDesc" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                             Margin="0,4,0,0"/>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="MaxMethodRadio" Style="{StaticResource MethodCard}" GroupName="Method"
                           Tag="Maximum" Checked="Method_Checked">
                <StackPanel>
                  <Grid>
                    <TextBlock x:Name="MaxMethodName" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource ThemeText}"/>
                    <TextBlock Text=".secf1v2" HorizontalAlignment="Right" Style="{StaticResource MutedText}"
                               FontSize="12"/>
                  </Grid>
                  <TextBlock x:Name="MaxMethodDesc" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                             Margin="0,4,0,0"/>
                </StackPanel>
              </RadioButton>

              <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}"
                      BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,6,0,0">
                <StackPanel>
                  <TextBlock x:Name="KeyFileTitle" FontSize="14" FontWeight="SemiBold"
                             Foreground="{DynamicResource ThemeText}"/>
                  <TextBlock x:Name="KeyFileText" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                             Margin="0,5,0,10"/>
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="KeyFileCreateButton" Style="{StaticResource SecondaryButton}"
                            Click="KeyFileCreate_Click"/>
                    <Button x:Name="KeyFileSelectButton" Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" Click="KeyFileSelect_Click"/>
                    <Button x:Name="KeyFileClearButton" Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" Click="KeyFileClear_Click"/>
                  </StackPanel>
                  <TextBlock x:Name="KeyFileNote" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                             FontSize="12" Margin="0,10,0,0"/>
                </StackPanel>
              </Border>

              <CheckBox x:Name="SecureDeleteCheck" Style="{StaticResource SettingCheckBox}" Margin="0,16,0,0"
                        Checked="Option_Changed" Unchecked="Option_Changed"/>
              <TextBlock x:Name="SecureDeleteNote" Style="{StaticResource MutedText}" FontSize="12"
                         Margin="28,4,0,0" TextWrapping="Wrap"/>
              <CheckBox x:Name="VerifyCheck" Style="{StaticResource SettingCheckBox}" Margin="0,14,0,0"
                        Checked="Option_Changed" Unchecked="Option_Changed"/>
              <TextBlock x:Name="VerifyNote" Style="{StaticResource MutedText}" FontSize="12"
                         Margin="28,4,0,0" TextWrapping="Wrap"/>

              <Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,18,0,18"/>

              <TextBlock x:Name="SettingsLanguageTitle" Text="Language" FontSize="16" FontWeight="SemiBold"
                         Foreground="{DynamicResource ThemeText}"/>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="LangEnButton" Content="English" Style="{StaticResource SecondaryButton}"
                        Tag="en" Click="Language_Click"/>
                <Button x:Name="LangRuButton" Content="Русский" Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0" Tag="ru" Click="Language_Click"/>
                <Button x:Name="LangDeButton" Content="Deutsch" Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0" Tag="de" Click="Language_Click"/>
                <Button x:Name="LangEsButton" Content="Español" Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0" Tag="es" Click="Language_Click"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <Grid Grid.Row="2" Margin="26,16,26,22">
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="SettingsMessageText" FontSize="12" Visibility="Collapsed"
                         TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Margin="0,0,0,4"/>
              <TextBlock Text="SecureFile" Style="{StaticResource MutedText}"/>
            </StackPanel>
            <Button x:Name="SettingsCloseButton" Content="Close" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" Click="CloseSettings_Click"/>
          </Grid>
        </Grid>
      </Border>
    </Border>

    <Border x:Name="ProtectionOverlay" Background="{DynamicResource ThemeOverlay}" Visibility="Collapsed">
      <Border Background="{DynamicResource ThemePanel}" BorderBrush="{DynamicResource ThemeBorder}"
              BorderThickness="1" CornerRadius="14" Padding="28" MaxWidth="440"
              VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
          <TextBlock x:Name="ProtectionTitle" Text="Protection" FontSize="22" FontWeight="Bold"
                     Foreground="{DynamicResource ThemeText}"/>
          <TextBlock x:Name="ProtectionStatusText" Style="{StaticResource MutedText}"
                     Margin="0,10,0,16" TextWrapping="Wrap"/>
          <TextBlock x:Name="ProtectionMessageText" FontSize="13" Margin="0,0,0,16"
                     TextWrapping="Wrap" Visibility="Collapsed"/>
          <Button x:Name="ChangePasswordButton" Content="Change master password"
                  Style="{StaticResource PrimaryButton}" Click="ChangePassword_Click"/>
          <Button x:Name="CloseProtectionButton" Content="Close" Style="{StaticResource SecondaryButton}"
                  Margin="0,10,0,0" Click="CloseProtection_Click"/>
        </StackPanel>
      </Border>
    </Border>

    <Border x:Name="PasswordOverlay" Background="{DynamicResource ThemeOverlay}" Visibility="Collapsed">
      <Border Background="{DynamicResource ThemePanel}" BorderBrush="{DynamicResource ThemeBorder}"
              BorderThickness="1" CornerRadius="14" Padding="28" MaxWidth="420"
              VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel KeyboardNavigation.TabNavigation="Cycle">
          <TextBlock x:Name="PasswordTitle" Text="Password" FontSize="22" FontWeight="Bold"
                     Foreground="{DynamicResource ThemeText}"/>
          <TextBlock x:Name="PasswordPromptText" Style="{StaticResource MutedText}"
                     Margin="0,8,0,16" TextWrapping="Wrap"/>
          <PasswordBox x:Name="PasswordPromptBox" Style="{StaticResource PasswordInput}" FontSize="15"/>
          <TextBlock x:Name="PasswordPromptError" Foreground="{DynamicResource ThemeError}" FontSize="13"
                     Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="PasswordOkButton" Content="OK" Style="{StaticResource PrimaryButton}"
                    Padding="22,8" Click="PasswordPromptOk_Click"/>
            <Button x:Name="PasswordCancelButton" Content="Cancel" Style="{StaticResource SecondaryButton}"
                    Padding="22,8" Margin="10,0,0,0" Click="PasswordPromptCancel_Click"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

  </Grid>
</Window>
